#!/bin/bash
# pkg 装完：登记输入法、打开、切过去（和 macos/install.sh 做的一样）。
# 这些要在登录用户自己的会话里做；安装器以 root 跑脚本时切到那个用户。
# 这里出错也不让安装失败：文件已经装好，最多要用户自己到系统设置里添加。
#
# $2 是安装位置；只装给当前用户时是 ~/Library/Input Methods。
user=$(/usr/bin/stat -f%Su /dev/console 2>/dev/null || true)
if [ "$(id -u)" -eq 0 ] && [ -n "$user" ] && [ "$user" != root ]; then
  home=$(/usr/bin/dscl . -read "/Users/$user" NFSHomeDirectory 2>/dev/null | /usr/bin/sed 's/^NFSHomeDirectory: //')
  uid=$(id -u "$user")
  as_user() { /bin/launchctl asuser "$uid" /usr/bin/sudo -u "$user" "$@"; }
else
  home=$HOME
  as_user() { "$@"; }
fi

app=
for candidate in "${2:-}/MyType.app" "$home/Library/Input Methods/MyType.app" "/Library/Input Methods/MyType.app"; do
  if [ -x "$candidate/Contents/MacOS/MyType" ]; then app=$candidate; break; fi
done
if [ -z "$app" ]; then
  echo "MyType postinstall: 找不到装好的 MyType.app（\$2=${2:-}）"
  exit 0
fi
# 安装器装出来的本来就没有隔离标记；保险起见再去一次
/usr/bin/xattr -dr com.apple.quarantine "$app" 2>/dev/null || true

bin="$app/Contents/MacOS/MyType"
as_user "$bin" --register || echo "MyType postinstall: 登记失败"
# 登记可能异步完成；一旦确认启用，只尝试切换一次，不重启系统输入法菜单。
for _ in 1 2 3 4 5 6 7 8; do
  if as_user "$bin" --enable >/dev/null 2>&1; then
    if ! as_user "$bin" --select; then
      echo "MyType postinstall: 装好了，菜单栏的输入法里选 MyType；没看到就到"
      echo "  系统设置 → 键盘 → 文字输入 → 输入法 → 编辑 → ＋ → 简体中文 → MyType 加一次"
    fi
    echo "MyType postinstall: 已启用 $app"
    exit 0
  fi
  sleep 1
done
echo "MyType postinstall: 未能自动启用，请到系统设置里添加"
exit 0
