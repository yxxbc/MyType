<?xml version="1.0" encoding="utf-8"?>
<!-- build.sh 把版本号填进来，用 productbuild 打成 MyType-<版本>-macos.pkg。
     只装给当前用户（~/Library/Input Methods），不要管理员密码；装完 postinstall 登记并切到 MyType。 -->
<installer-gui-script minSpecVersion="2">
    <title>MyType @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <allowed-os-versions>
        <os-version min="12.0"/>
    </allowed-os-versions>
    <choices-outline>
        <line choice="wowtype"/>
    </choices-outline>
    <choice id="wowtype" title="MyType" visible="false">
        <pkg-ref id="io.github.yxxbc.inputmethod.MyType.pkg"/>
    </choice>
    <pkg-ref id="io.github.yxxbc.inputmethod.MyType.pkg" version="@VERSION@" onConclusion="none">MyType-component.pkg</pkg-ref>
</installer-gui-script>
