{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mytype",
  "main": "src/index.js",
  "compatibility_date": "2026-11-15",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "mytype.xynrin.cc.cd", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
